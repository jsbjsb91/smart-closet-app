# Credenciales de Firebase Authentication
# Obtenidas en Firebase Console -> Configuración del Proyecto -> Tus apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: Gemini API Key para análisis de fotos de prendas
VITE_GEMINI_API_KEY=
